// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
  JOURNALIST
  COMMENTATOR
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  RESULTS_COUNTING
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExperienceVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

/** Внешняя платформа, на которой доказывается владение игровым аккаунтом. */
enum ExternalProvider {
  STEAM
  FACEIT
  RIOT
}

/**
 * Чем именно подтверждён опыт. Порядок важен: чем ниже в списке, тем выше доверие
 * (числовое значение хранится отдельно в UserGameProfile.trustLevel).
 */
enum VerificationMethod {
  NONE
  SELF_REPORTED
  SCREENSHOT
  LINKED_ACCOUNT
  API
}

enum VerificationChallengeKind {
  /** Код нужно временно вписать в поле профиля Steam. */
  STEAM_PROFILE_CODE
  /** Код должен быть виден в кадре скриншота. */
  SCREENSHOT_CODE
}

enum CurrencyCode {
  RUB
}

enum PaymentProvider {
  TBANK
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum PrizeMode {
  ENTRY_FEES
  SPONSOR
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  username             String                    @unique
  displayName          String?
  avatarUrl            String?
  bio                  String?
  passwordHash         String
  role                 Role                      @default(USER)
  isBanned             Boolean                   @default(false)
  banReason            String?
  phone                String?                   @unique
  phoneVerifiedAt      DateTime?
  phoneVerificationCodeHash  String?
  phoneVerificationExpires   DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  registrations        TournamentRegistration[]
  captainApplications  TeamApplication[]         @relation("TeamCaptain")
  teamApplicationLinks TeamApplicationMember[]
  notifications        UserTournamentNotification[]
  auditEvents          AuditLog[]                @relation("AuditActor")
  newsPosts            NewsPost[]                @relation("NewsAuthor")
  gameProfiles         UserGameProfile[]
  externalAccounts     ExternalAccount[]
  verificationChallenges VerificationChallenge[]
  dialogsAsParticipantA ChatDialog[]             @relation("DialogParticipantA")
  dialogsAsParticipantB ChatDialog[]             @relation("DialogParticipantB")
  sentChatMessages     ChatMessage[]             @relation("ChatMessageSender")
  readChatMessages     ChatMessage[]             @relation("ChatMessageReader")
  streamCommentsEdited StreamComment[]           @relation("StreamCommentEditor")
  friendshipsRequested Friendship[]              @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]              @relation("FriendshipAddressee")
}

model Game {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  iconUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tournaments Tournament[]
  userProfiles UserGameProfile[]
  verificationChallenges VerificationChallenge[]
}

model UserGameProfile {
  id           String   @id @default(cuid())
  mmr          Int?
  rankLabel    String?
  hoursPlayed  Int?
  primaryRole  String?
  experienceVerificationStatus ExperienceVerificationStatus @default(NOT_SUBMITTED)
  experienceProofImageUrl String?
  experienceProofSubmittedAt DateTime?
  experienceVerificationReviewedAt DateTime?
  experienceVerificationNote String?

  // --- Провенанс подтверждения: откуда взяты данные и насколько им можно верить ---
  /** Чем подтверждён опыт. Управляет trustLevel. */
  verificationMethod   VerificationMethod @default(NONE)
  /** Числовой уровень доверия, см. src/lib/verification/trust.ts. Дублирует method для быстрых сравнений в запросах. */
  trustLevel           Int                @default(0)
  /** Платформа, с которой прочитаны verified* поля. */
  verificationSource   ExternalProvider?
  /** Ранг, прочитанный из внешнего API (не то, что ввёл пользователь). */
  verifiedRankLabel    String?
  /** Числовой рейтинг из API: MMR, CS Rating, RR. */
  verifiedRankNumeric  Int?
  /** Часы в игре по данным платформы. */
  verifiedHoursPlayed  Int?
  /** Сработавшие сигналы риска, см. src/lib/verification/flags.ts. */
  verificationFlags    String[]           @default([])
  /** Когда последний раз успешно синхронизировали данные из API. */
  verificationSyncedAt DateTime?
  /** После этой даты снимок считается протухшим и требует пересинхронизации. */
  verificationExpiresAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  gameId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([verificationExpiresAt])
}

/**
 * Доказанная привязка сайтового аккаунта к внешнему игровому.
 * Уникальность по (provider, providerAccountId) не даёт двум людям
 * использовать один и тот же Steam/FACEIT аккаунт как «свой».
 */
model ExternalAccount {
  id                String           @id @default(cuid())
  provider          ExternalProvider
  /** SteamID64 / FACEIT player_id / Riot PUUID. */
  providerAccountId String
  /** Ник на платформе на момент последней проверки. */
  handle            String?
  profileUrl        String?
  avatarUrl         String?
  /** Как именно доказано владение: OPENID, OAUTH, PROFILE_CODE. */
  proofMethod       String
  linkedAt          DateTime         @default(now())
  lastCheckedAt     DateTime?
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

/**
 * Чёрный список внешних аккаунтов. Живёт отдельно от ExternalAccount,
 * чтобы блокировка не исчезала вместе с отвязкой аккаунта.
 */
model BlockedExternalAccount {
  id                String           @id @default(cuid())
  provider          ExternalProvider
  providerAccountId String
  reason            String?
  createdAt         DateTime         @default(now())

  @@unique([provider, providerAccountId])
}

/** Одноразовый код для доказательства владения без OAuth. */
model VerificationChallenge {
  id         String                    @id @default(cuid())
  code       String                    @unique
  kind       VerificationChallengeKind
  provider   ExternalProvider?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                  @default(now())
  userId     String
  gameId     String?
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game?                     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

model Tournament {
  id              String                     @id @default(cuid())
  title           String
  slug            String                     @unique
  description     String?
  format          TournamentFormat
  status          TournamentStatus           @default(DRAFT)
  teamSize        Int                        @default(1)
  maxTeams        Int                        @default(16)
  maxParticipants Int
  entryFeeMinor   Int                        @default(0)
  currency        CurrencyCode               @default(RUB)
  eventDate       DateTime?
  prizeMode       PrizeMode                  @default(ENTRY_FEES)
  sponsorPrizeText String?
  startsAt        DateTime
  endsAt          DateTime?
  rules           String?
  requiresVerifiedExperience Boolean                   @default(false)
  isPublished     Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  gameId          String
  game            Game                       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  registrations   TournamentRegistration[]
  teamApplications TeamApplication[]
  notifications   UserTournamentNotification[]
  matches         Match[]
}

model TournamentRegistration {
  id           String             @id @default(cuid())
  status       RegistrationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userId       String
  tournamentId String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
}

model Match {
  id             String      @id @default(cuid())
  round          Int
  orderInRound   Int
  bracketSegment String      @default("UPPER")
  participantA   String?
  participantB   String?
  scoreA         Int         @default(0)
  scoreB         Int         @default(0)
  scheduledAt    DateTime?
  status         MatchStatus @default(SCHEDULED)
  winnerLabel    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tournamentId   String
  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model TeamApplication {
  id            String                 @id @default(cuid())
  teamName      String
  teamLogoUrl   String?
  status        TeamApplicationStatus  @default(PENDING)
  paymentStatus PaymentStatus          @default(UNPAID)
  paymentProvider PaymentProvider?
  paymentId     String?
  paymentOrderId String?
  paidAt        DateTime?
  refundId      String?
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  captainId     String
  tournamentId  String
  captain       User                   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members       TeamApplicationMember[]
  notifications UserTournamentNotification[]

  @@unique([captainId, tournamentId])
  @@unique([paymentId])
  @@unique([paymentOrderId])
}

model TeamApplicationMember {
  id              String          @id @default(cuid())
  username        String
  isCaptain       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  applicationId   String
  linkedUserId    String?
  application     TeamApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  linkedUser      User?           @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@unique([applicationId, username])
}

model UserTournamentNotification {
  id                String          @id @default(cuid())
  message           String
  isRead            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  userId            String
  tournamentId      String
  teamApplicationId String?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamApplication   TeamApplication? @relation(fields: [teamApplicationId], references: [id], onDelete: SetNull)
}

model NewsPost {
  id         String   @id @default(cuid())
  title      String
  body       String
  imageUrl   String?
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  authorId   String
  author     User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model StreamComment {
  id          String   @id @default(cuid())
  key         String   @unique @default("main")
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("StreamCommentEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  ctaLabel   String?
  ctaHref    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model Friendship {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       FriendshipStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  respondedAt  DateTime?
  requester    User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model ChatDialog {
  id             String        @id @default(cuid())
  participantAId String
  participantBId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  participantA   User          @relation("DialogParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   User          @relation("DialogParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
  @@index([updatedAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  dialogId   String
  senderId   String
  body       String
  createdAt  DateTime   @default(now())
  readAt     DateTime?
  readById   String?
  dialog     ChatDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)
  sender     User       @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  readBy     User?      @relation("ChatMessageReader", fields: [readById], references: [id], onDelete: SetNull)

  @@index([dialogId, createdAt])
  @@index([senderId])
  @@index([createdAt])
}
