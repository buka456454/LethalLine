// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
  JOURNALIST
  COMMENTATOR
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  RESULTS_COUNTING
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExperienceVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum CurrencyCode {
  RUB
}

enum PaymentProvider {
  TBANK
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum PrizeMode {
  ENTRY_FEES
  SPONSOR
}

model User {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  username             String                    @unique
  displayName          String?
  avatarUrl            String?
  bio                  String?
  passwordHash         String
  role                 Role                      @default(USER)
  isBanned             Boolean                   @default(false)
  banReason            String?
  phone                String?                   @unique
  phoneVerifiedAt      DateTime?
  phoneVerificationCodeHash  String?
  phoneVerificationExpires   DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  registrations        TournamentRegistration[]
  captainApplications  TeamApplication[]         @relation("TeamCaptain")
  teamApplicationLinks TeamApplicationMember[]
  notifications        UserTournamentNotification[]
  auditEvents          AuditLog[]                @relation("AuditActor")
  newsPosts            NewsPost[]                @relation("NewsAuthor")
  gameProfiles         UserGameProfile[]
  dialogsAsParticipantA ChatDialog[]             @relation("DialogParticipantA")
  dialogsAsParticipantB ChatDialog[]             @relation("DialogParticipantB")
  sentChatMessages     ChatMessage[]             @relation("ChatMessageSender")
  readChatMessages     ChatMessage[]             @relation("ChatMessageReader")
  streamCommentsEdited StreamComment[]           @relation("StreamCommentEditor")
}

model Game {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  iconUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tournaments Tournament[]
  userProfiles UserGameProfile[]
}

model UserGameProfile {
  id           String   @id @default(cuid())
  mmr          Int?
  rankLabel    String?
  hoursPlayed  Int?
  primaryRole  String?
  experienceVerificationStatus ExperienceVerificationStatus @default(NOT_SUBMITTED)
  experienceProofImageUrl String?
  experienceProofSubmittedAt DateTime?
  experienceVerificationReviewedAt DateTime?
  experienceVerificationNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  gameId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Tournament {
  id              String                     @id @default(cuid())
  title           String
  slug            String                     @unique
  description     String?
  format          TournamentFormat
  status          TournamentStatus           @default(DRAFT)
  teamSize        Int                        @default(1)
  maxTeams        Int                        @default(16)
  maxParticipants Int
  entryFeeMinor   Int                        @default(0)
  currency        CurrencyCode               @default(RUB)
  eventDate       DateTime?
  prizeMode       PrizeMode                  @default(ENTRY_FEES)
  sponsorPrizeText String?
  startsAt        DateTime
  endsAt          DateTime?
  rules           String?
  requiresVerifiedExperience Boolean                   @default(false)
  isPublished     Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  gameId          String
  game            Game                       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  registrations   TournamentRegistration[]
  teamApplications TeamApplication[]
  notifications   UserTournamentNotification[]
  matches         Match[]
}

model TournamentRegistration {
  id           String             @id @default(cuid())
  status       RegistrationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userId       String
  tournamentId String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
}

model Match {
  id             String      @id @default(cuid())
  round          Int
  orderInRound   Int
  bracketSegment String      @default("UPPER")
  participantA   String?
  participantB   String?
  scoreA         Int         @default(0)
  scoreB         Int         @default(0)
  scheduledAt    DateTime?
  status         MatchStatus @default(SCHEDULED)
  winnerLabel    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tournamentId   String
  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model TeamApplication {
  id            String                 @id @default(cuid())
  teamName      String
  teamLogoUrl   String?
  status        TeamApplicationStatus  @default(PENDING)
  paymentStatus PaymentStatus          @default(UNPAID)
  paymentProvider PaymentProvider?
  paymentId     String?
  paymentOrderId String?
  paidAt        DateTime?
  refundId      String?
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  captainId     String
  tournamentId  String
  captain       User                   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members       TeamApplicationMember[]
  notifications UserTournamentNotification[]

  @@unique([captainId, tournamentId])
  @@unique([paymentId])
  @@unique([paymentOrderId])
}

model TeamApplicationMember {
  id              String          @id @default(cuid())
  username        String
  isCaptain       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  applicationId   String
  linkedUserId    String?
  application     TeamApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  linkedUser      User?           @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@unique([applicationId, username])
}

model UserTournamentNotification {
  id                String          @id @default(cuid())
  message           String
  isRead            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  userId            String
  tournamentId      String
  teamApplicationId String?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamApplication   TeamApplication? @relation(fields: [teamApplicationId], references: [id], onDelete: SetNull)
}

model NewsPost {
  id         String   @id @default(cuid())
  title      String
  body       String
  imageUrl   String?
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  authorId   String
  author     User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model StreamComment {
  id          String   @id @default(cuid())
  key         String   @unique @default("main")
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("StreamCommentEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  ctaLabel   String?
  ctaHref    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model ChatDialog {
  id             String        @id @default(cuid())
  participantAId String
  participantBId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  participantA   User          @relation("DialogParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   User          @relation("DialogParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
  @@index([updatedAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  dialogId   String
  senderId   String
  body       String
  createdAt  DateTime   @default(now())
  readAt     DateTime?
  readById   String?
  dialog     ChatDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)
  sender     User       @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  readBy     User?      @relation("ChatMessageReader", fields: [readById], references: [id], onDelete: SetNull)

  @@index([dialogId, createdAt])
  @@index([senderId])
  @@index([createdAt])
}
